enum ProjectAvailabilityStatus {
  OPEN
  CLOSED
}

model Project {
  id String @id @default(uuid())

  client   User   @relation(fields: [clientId], references: [id])
  clientId String

  title            String
  category         ProjectCategory
  scope            ProjectScope      @default(FULL_PROJECT)
  servicesRequired ServiceType[]
  description      String

  address           String
  city              String
  state             String
  pincode           String
  propertySize      Float
  numberOfFloors    Int?
  numberOfBedrooms  Int?
  numberOfBathrooms Int?
  propertyStatus    PropertyStatus

  designStyle          DesignStyle[]
  colorPreferences     String?
  spaceRequirements    SpaceRequirement[]
  accessibilityNeeds   String?
  spaceUsers           String?
  currentSpaceLikes    String?
  currentSpaceProblems String?
  clientInvolvement    ClientInvolvement?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  budgetMin Float
  budgetMax Float

  startDate      DateTime
  completionDate DateTime

  priority Priority @default(NORMAL)

  siteVisitRequired      Boolean            @default(false)
  preferredCommunication CommunicationMode?
  preferredWorkingHours  String?
  additionalNotes        String?

  status             ProjectStatus             @default(WAITING_FOR_QUOTATIONS)
  currentPhase       ProjectPhase?
  availabilityStatus ProjectAvailabilityStatus @default(OPEN)
  biddingDeadline    DateTime?
  version            Int                       @default(1)

  attachments Attachment[]
  bids        Bid[]
  awards      Award[]
  teamMembers ProjectTeam[]
  chats       Chat[]
  reviews     Review[]
  escrow      ProjectEscrow?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([category])
  @@index([status])
  @@index([currentPhase])
  @@index([availabilityStatus])
  @@index([biddingDeadline])
}

model Attachment {
  id String @id @default(uuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  type AttachmentType
  url  String

  createdAt DateTime @default(now())

  @@index([projectId])
}

model Award {
  id          String      @id @default(uuid())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  bid         Bid         @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidId       String      @unique
  role        ServiceType
  awardedBy   User        @relation("AwardsGiven", fields: [awardedById], references: [id], onDelete: Cascade)
  awardedById String
  awardedAt   DateTime    @default(now())

  contract    Contract?
  reviews     Review[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, role])
  @@index([projectId])
  @@index([bidId])
  @@index([awardedById])
}

model Contract {
  id                String          @id @default(uuid())
  award             Award           @relation(fields: [awardId], references: [id], onDelete: Cascade)
  awardId           String          @unique
  scopeDescription  String?
  totalAmount       Float
  milestoneSchedule Json?
  status            ContractStatus  @default(ACTIVE)

  milestones        Milestone[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([awardId])
  @@index([status])
}

model Milestone {
  id            String          @id @default(uuid())
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId    String
  sequence      Int             @default(1)
  title         String
  description   String?
  amount        Float
  status        MilestoneStatus @default(PENDING)
  submittedAt   DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?
  proofUrls     String[]        @default([])
  notes         String?
  version       Int             @default(1)

  payments      Payment[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([contractId])
  @@index([status])
}

