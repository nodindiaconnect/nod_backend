model RateLimit {
  id           String    @id @default(uuid())
  identifier   String
  action       String
  count        Int       @default(1)
  windowStart  DateTime
  blockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, action])
  @@index([blockedUntil])
}

model AuthSession {
  id        String   @id @default(uuid())
  token     String   @unique
  type      String // "register" | "forgot"
  step      String // register: started -> verified -> profile_complete
  // forgot:   started -> verified
  email     String
  userId    String?
  attempts  Int      @default(0)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expireAt  DateTime

  @@index([email])
  @@index([expireAt])
}

model User {
  id          String  @id @default(uuid())
  name        String
  username    String? @unique
  email       String
  phone       String?
  countryCode String?
  password    String
  role        Int     @default(1)

  isVerified   Boolean @default(false)
  isRegistered Boolean @default(false)
  isActive     Boolean @default(false)
  isBlocked    Boolean @default(false)
  isDeleted    Boolean @default(false)
  forgotReq    Boolean @default(false)

  permissions String[] @default([])

  loginTime      DateTime?
  registeredDate DateTime?
  activeDate     DateTime?

  country String? @default("N/A")
  state   String? @default("N/A")
  city    String? @default("N/A")
  address String? @default("N/A")
  profile String?

  walletBalance Float @default(0)

  otps       Otp[]
  wallets    Wallet[]
  projects   Project[] // opposite side of Project.client relation
  products   Product[]
  architect  Architect?
  contractor Contractor?
  designer   Designer?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  specialization      String?

  posts     Post[]
  followers Follow[] @relation("Following") // people who follow this user
  following Follow[] @relation("Follower") // people this user follows

  contactDetails ContactDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isDeleted])
  @@index([isActive, isBlocked])
}
