model Otp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpType    String
  otp        Int
  attempts   Int      @default(0)
  expireTime DateTime

  createdAt DateTime @default(now())

  @@index([userId, otpType])
    @@index([expireTime])
}